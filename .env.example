# ==============================================================================
# LOOPX — ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and customize as needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OWNER CREDENTIALS (Change credentials easily here)
# ------------------------------------------------------------------------------
VITE_OWNER_USERNAME=Jagan
VITE_OWNER_PASSWORD=12345678910

# ------------------------------------------------------------------------------
# 2. EMPLOYEE CREDENTIALS (Shared employee workspace entry)
# ------------------------------------------------------------------------------
VITE_EMPLOYEE_USERNAME=Jagan team
VITE_EMPLOYEE_PASSWORD=123456789

# ------------------------------------------------------------------------------
# 3. SUPABASE CONFIGURATION (Connect after creating your Supabase project)
# ------------------------------------------------------------------------------
# Once you create your Supabase project at https://supabase.com:
# Paste your Project URL and anon public API key below.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Storage bucket name for client documents & photos
VITE_SUPABASE_STORAGE_BUCKET=loopx-documents
