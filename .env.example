# ==============================================================================
# LOOPX — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# HOW TO USE:
#   1. Copy this file to .env  (cp .env.example .env)
#   2. Fill in real values in .env
#   3. Never commit .env to GitHub — it is excluded by .gitignore
#
# This .env.example file is safe to commit: it contains no real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# [SECTION 1] — OWNER USERNAME
# ------------------------------------------------------------------------------
# The owner login username (not secret — safe as plain text).
# Leave blank to use the default 'Jagan' set in src/config/auth.config.js.
#
# PASSWORD MANAGEMENT:
#   Passwords are stored as SHA-256 hashes in src/config/auth.config.js.
#   They are NOT stored in .env. To change a password:
#     1. Generate hash: node -e "const c=require('crypto'); console.log(c.createHash('sha256').update('NEW_PASS').digest('hex'));"
#     2. Update OWNER_PASSWORD_HASH in src/config/auth.config.js (Section 1).
# ------------------------------------------------------------------------------
VITE_OWNER_USERNAME=Jagan

# ------------------------------------------------------------------------------
# [SECTION 2] — EMPLOYEE USERNAME
# ------------------------------------------------------------------------------
# Shared login username for all employees.
# Individual identity is set by choosing a profile name inside the workspace.
# Leave blank to use the default 'Jagan team' set in src/config/auth.config.js.
# (See password change instructions above — same process for employee password.)
# ------------------------------------------------------------------------------
VITE_EMPLOYEE_USERNAME=Jagan team

# ------------------------------------------------------------------------------
# [SECTION 3] — SUPABASE CONNECTION
# ------------------------------------------------------------------------------
# How to get these values:
#   1. Create a project at https://supabase.com
#   2. Go to Project Settings → API
#   3. Copy "Project URL" and "anon public" key
#   4. Run supabase/schema.sql in the Supabase SQL Editor to create all tables
#
# Leave blank to run in local standby mode (browser localStorage only).
# NEVER put the service_role (admin) key here — anon key only.
# NEVER put any VITE_ variable in .env.example with real credentials.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# [SECTION 4] — SUPABASE STORAGE BUCKET
# ------------------------------------------------------------------------------
# Name of the private storage bucket for client document/photo uploads.
# This bucket is created automatically by supabase/schema.sql.
# Only change if you rename the bucket in Supabase Dashboard.
# ------------------------------------------------------------------------------
VITE_SUPABASE_STORAGE_BUCKET=loopx-documents
