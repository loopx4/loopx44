# ==============================================================================
# LOOPX — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# HOW TO USE:
#   1. Copy this file to .env  (cp .env.example .env)
#   2. Fill in real values in .env
#   3. Never commit .env to GitHub — it is excluded by .gitignore
#
# This .env.example file is safe to commit: it contains no real secrets or hashes.
# ==============================================================================

# ------------------------------------------------------------------------------
# [SECTION 1] — SERVER-SIDE AUTHENTICATION (EXPRESS DEV SERVER & CLOUDFLARE)
# These variables are read ONLY by backend servers and are NEVER exposed to Vite.
#
# To generate a bcrypt hash for a new password:
#   node -e "require('bcryptjs').hash('YOUR_PASSWORD', 12).then(console.log)"
#
# To generate a JWT secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ------------------------------------------------------------------------------
OWNER_USERNAME=Jagan
OWNER_BCRYPT_HASH=<paste_owner_bcrypt_hash_here>

EMPLOYEE_USERNAME=Jagan team
EMPLOYEE_BCRYPT_HASH=<paste_employee_bcrypt_hash_here>

JWT_SECRET=<paste_random_48_byte_hex_secret_here>
SESSION_MAX_AGE_SECONDS=28800
SERVER_PORT=3001
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# [SECTION 2] — SUPABASE CONNECTION (OPTIONAL FOR CLOUD PERSISTENCE)
# ------------------------------------------------------------------------------
# Leave blank to run in local standby mode (browser localStorage only).
# WARNING: Never put the service_role (admin) key here — anon key only.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_STORAGE_BUCKET=loopx-documents
